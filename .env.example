# ---------------------------------------------------------------
# Homework 2 workbench — example environment.
# Copy to backend/.env (or export the same names) before running.
# Only the backend reads the model key; never commit real secrets.
# ---------------------------------------------------------------

# --- model connection (DeepSeek-compatible endpoint) ------------
HW2_MODEL_PROVIDER=deepseek
HW2_MODEL_BASE_URL=https://api.deepseek.com
HW2_MODEL_NAME=deepseek-chat
# Placeholder only. A missing value disables NEW model tasks with a
# clear configuration error; the workbench and existing tasks still work.
HW2_MODEL_API_KEY=
HW2_MODEL_TEMPERATURE=0.0

# --- storage / server ------------------------------------------
# Defaults to <Test2>/data when unset.
# HW2_DATA_DIR=../data
HW2_HOST=127.0.0.1
HW2_PORT=8000
HW2_FRONTEND_ORIGIN=http://localhost:5173
HW2_LOG_LEVEL=info

# --- upload limits ---------------------------------------------
HW2_MAX_UPLOAD_FILES=64
HW2_MAX_UPLOAD_FILE_BYTES=524288
HW2_MAX_UPLOAD_TOTAL_BYTES=8388608

# --- budgets: business counts (default / server cap) -----------
# Repair rounds: 2 / 10 ; verification retries: 2 / 10 ;
# review retries: 2 / 10 ; fix retries: 2 / 10 ; evidence retries: 2 / 10 ;
# parent corrections: 2 / 5 ; model retries: 2 / 5
HW2_MAX_REPAIR_ROUNDS=2
HW2_MAX_VERIFICATION_RETRIES=2
HW2_MAX_REVIEW_RETRIES=2
HW2_MAX_FIX_RETRIES=2
HW2_MAX_EVIDENCE_RETRIES=2
HW2_MAX_PARENT_CORRECTIONS=2
HW2_MAX_MODEL_RETRIES=2

# --- budgets: execution limits (default / server cap) ----------
# tool steps 12/64 ; model timeout 60/180 ; tool timeout 30/120 ;
# attempt timeout 180/600 ; graph steps 256/2048
HW2_MAX_TOOL_STEPS=12
HW2_MODEL_TIMEOUT_SECONDS=60
HW2_TOOL_TIMEOUT_SECONDS=30
HW2_ATTEMPT_TIMEOUT_SECONDS=180
HW2_MAX_GRAPH_STEPS=256
